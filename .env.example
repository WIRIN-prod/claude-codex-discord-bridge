DISCORD_BOT_TOKEN=replace-with-bot-token
DISCORD_GUILD_ID=123456789012345678
# Optional: category where per-project channels are created
DISCORD_CATEGORY_ID=
# Discord user ID(s) allowed to start/use sessions, comma-separated
DISCORD_ALLOWED_USER_IDS=123456789012345678
# Absolute path whose immediate child directories are project folders
PROJECTS_ROOT=/home/your-user/projects
CLAUDE_DISCORD_HOOK_SECRET=replace-with-a-long-random-secret
# Optional overrides
CLAUDE_DISCORD_HOOK_URL=http://127.0.0.1:8787/hooks/claude
# CLAUDE_COMMAND=claude
